# Maintainer: rustle
pkgname=python-yewtube-search-python
_name=${pkgname#python-}
pkgver=1.6.7
pkgrel=1
pkgdesc="Search for YouTube videos, channels and playlists without the Data API (yewtube's fork)"
arch=(any)
url="https://github.com/iamtalhaasghar/youtube-search-python"
license=(MIT)
depends=(python-httpx)
makedepends=(python-build python-installer python-setuptools python-wheel)
# Source is pinned to the PyPI sdist (no # auto: marker, calawk precedent):
# yewtube requires yewtube-search-python>=1.6.7, and the newest GitHub tag on
# the fork is v1.6.6, so the tag API cannot resolve this version. Pinning also
# keeps the build off the GitHub API. The sdist extracts to
# yewtube_search_python-$pkgver (underscores).
source=("$_name-$pkgver.tar.gz::https://files.pythonhosted.org/packages/3a/7a/8ed3133214207ff95f503e9c20a69b469a28d47f7a9bdf274b044e0f5b95/yewtube_search_python-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "yewtube_search_python-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "yewtube_search_python-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}