# Maintainer: rustle
pkgname=superfile
pkgver=1.6.0
pkgrel=1
pkgdesc="Pretty fancy and modern terminal file manager"
arch=(x86_64)
url="https://github.com/yorukot/superfile"
license=(MIT)
depends=(glibc)
makedepends=(go)
options=(!lto !strip)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  mkdir -p bin
  CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o bin/spf .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 bin/spf "$pkgdir/usr/bin/spf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 NOTICE.md "$pkgdir/usr/share/doc/$pkgname/NOTICE.md" 2>/dev/null || true
}
