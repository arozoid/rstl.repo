# Maintainer: rustle
pkgname=clipse
pkgver=1.2.1
pkgrel=1
pkgdesc="Configurable TUI clipboard manager for Unix"
arch=(x86_64)
url="https://github.com/savedra1/clipse"
license=(MIT)
depends=(glibc wl-clipboard)
makedepends=(go)
options=(!lto !strip)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  CGO_ENABLED=0 go build -tags wayland -o clipse
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 clipse "$pkgdir/usr/bin/clipse"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}