# Maintainer: rustle
pkgname=chroncal
pkgver=0.10.0
pkgrel=1
pkgdesc="Terminal-first calendar, todo and journal manager"
arch=(x86_64)
url="https://github.com/DouglasdeMoura/chroncal"
license=(MIT)
depends=(glibc)
optdepends=('xclip: system clipboard support (atotto/clipboard)'
            'xsel: system clipboard support (atotto/clipboard)'
            'libnotify: desktop notifications (beeep)')
makedepends=(go)
options=(!lto !strip)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o chroncal ./cmd/chroncal
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 chroncal "$pkgdir/usr/bin/chroncal"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}