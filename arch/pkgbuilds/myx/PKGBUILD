# Maintainer: rustle
pkgname=myx
pkgver=0.5.0
pkgrel=1
pkgdesc="A lean, beautiful terminal Spotify player"
arch=(x86_64)
url="https://github.com/HaseebKhalid1507/Myx"
license=(MIT)
depends=(gcc-libs alsa-lib openssl)
makedepends=(cargo rust alsa-lib openssl)
options=(!lto)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "Myx-$pkgver"
  # the released tarball's Cargo.lock can drift from Cargo.toml; --locked
  # refuses to regenerate it, so refresh deps first, then lock deterministically
  cargo update
  cargo build --release --locked
}

package() {
  cd "Myx-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/myx" "$pkgdir/usr/bin/myx"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}