# Maintainer: rustle
pkgname=phinger-cursors
pkgver=2.1
pkgrel=1
pkgdesc='Phinger cursors: dark theme, 48px size only'
url='https://github.com/phisch/phinger-cursors'
license=('CC-BY-SA-4.0')
arch=('any')
makedepends=('python')
# auto: release
source=("$pkgname-$pkgver.tar.bz2::$url/releases/download/v${pkgver}/${pkgname}-variants.tar.bz2"
        'file://phinger-strip.py')
sha256sums=('ddb7310c62bf8e0e2798a24f8a867e4af7b17a39757ba45c85e13f3988f646fc'
            '3f91fc4ac77a59e7667868f3c03bbc62e6291f899166c65e6f5026d488acdc0d')

package() {
  src="$srcdir/phinger-cursors-dark"
  install -dm755 "$pkgdir/usr/share/icons"
  cp -a "$src" "$pkgdir/usr/share/icons/"
  find "$pkgdir/usr/share/icons/phinger-cursors-dark/cursors" -type f \
    -exec python3 "$srcdir/phinger-strip.py" {} +
}