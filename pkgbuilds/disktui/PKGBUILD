# Maintainer: rustle
pkgname=disktui
pkgver=1.3.0
pkgrel=1
pkgdesc="TUI for disk management and partitioning"
arch=(x86_64)
url="https://github.com/mkbula/disktui"
license=(MIT)
depends=(gcc-libs parted e2fsprogs cryptsetup polkit which util-linux)
optdepends=('dosfstools: FAT32 filesystem support'
            'ntfsprogs: NTFS filesystem support'
            'exfatprogs: exFAT filesystem support'
            'btrfs-progs: Btrfs filesystem support'
            'xfsprogs: XFS filesystem support'
            'smartmontools: SMART disk health monitoring')
makedepends=(rustup)
options=(!lto)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/disktui" "$pkgdir/usr/bin/disktui"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/disktui-helper" "$pkgdir/usr/bin/disktui-helper"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
