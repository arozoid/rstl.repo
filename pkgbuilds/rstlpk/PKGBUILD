# Maintainer: arozoid 
pkgname=rstlpk
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimal polkit authentication agent for the rstl.sway rice (no gtk)"
arch=(x86_64)
url="https://github.com/arozoid/rstlpk"
license=(MIT)
depends=(polkit)
makedepends=(rustup)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
