# Maintainer: rustle
pkgname=rstl-pick
pkgver=0.1.0
pkgrel=2
pkgdesc="Compact fuzzy-search TUI app picker for the rstl.sway desktop"
arch=(x86_64)
url="https://github.com/arozoid/rstl-pick"
license=(MIT)
depends=(glibc gcc-libs)
makedepends=(cargo rust)
options=(!lto)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  # the released tarball's Cargo.lock can drift from Cargo.toml; --locked
  # refuses to regenerate it, so refresh deps first, then lock deterministically
  cargo update
  cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}