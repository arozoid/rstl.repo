# Maintainer: arozoid
pkgname=concord-bin
pkgver=2.5.16
pkgrel=1
pkgdesc="A feature-rich TUI client for Discord"
arch=(x86_64)
url="https://github.com/chojs23/concord"
license=(GPL-3.0-only)
depends=(alsa-lib glibc libgcc)
options=(!strip)
# auto: release
_barch=x86_64-unknown-linux-gnu
source=("$pkgname-$pkgver.tar.xz::$url/releases/download/v$pkgver/concord-$_barch.tar.xz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/concord-$_barch"
  install -Dm755 concord "$pkgdir/usr/bin/concord"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}