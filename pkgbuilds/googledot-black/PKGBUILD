# Maintainer: rustle
pkgname=googledot-black
pkgver=2.0.0
pkgrel=1
pkgdesc="Cursor theme inspired on Google — GoogleDot-Black only"
arch=(any)
url="https://github.com/ful1e5/Google_Cursor"
license=(GPL-3.0-or-later)
makedepends=("python-clickgen>2.0.0")
provides=(googledot-cursor-theme)
conflicts=(googledot-cursor-theme)
options=(!strip)
# auto: release
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "Google_Cursor-$pkgver"
  rm -rf themes
}

build() {
  cd "Google_Cursor-$pkgver"
  ctgen build.toml -p x11 -d bitmaps/GoogleDot-Black \
    -n GoogleDot-Black -c 'Black cursor theme inspired on Google'
}

package() {
  cd "Google_Cursor-$pkgver"
  install -d "$pkgdir/usr/share/icons"
  cp -r themes/GoogleDot-Black "$pkgdir/usr/share/icons/"
}
