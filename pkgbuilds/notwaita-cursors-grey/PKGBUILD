# Maintainer: arozoid
pkgname=notwaita-cursors-grey
_release=1.0.0-alpha1
pkgver=${_release//-/.}
pkgrel=2
pkgdesc="Grey Notwaita cursor theme - Adwaita-inspired, HiDPI (grey only, trimmed to 24/32/48px)"
arch=(any)
url="https://github.com/ful1e5/notwaita-cursor"
license=(custom)
depends=(hicolor-icon-theme)
makedepends=(python)
source=("$pkgname-$pkgver.tar.xz::$url/releases/download/v$_release/Notwaita-Gray.tar.xz")
sha256sums=('SKIP')

# strip every Xcursor file down to the 24/32/48 px frames (the upstream ships
# 16..96 per cursor; 15 MiB of unused HiDPI frames are not worth carrying)
trim_xcursor() {
  python3 - "$@" <<'PY'
import struct, sys, os

KEEP = {24, 32, 48}

def trim(d, keep=KEEP):
    magic, hsize, ver, ntoc = struct.unpack('<4sIII', d[:16])
    toc = [struct.unpack('<III', d[16 + 12 * i:28 + 12 * i]) for i in range(ntoc)]
    kept = []
    for i, (t, sub, pos) in enumerate(toc):
        end = toc[i + 1][2] if i + 1 < len(toc) else len(d)
        chunk = d[pos:end]
        if t == 0xfffd0002:
            _, _, nom = struct.unpack('<3I', chunk[:12])
            if nom not in keep:
                continue
        kept.append((t, sub, chunk))

    out = bytearray(b'Xcur')
    out += struct.pack('<III', hsize, ver, len(kept))
    hdr = 16 + 12 * len(kept)
    cur = (hdr + 7) & ~7
    entries = []
    for t, sub, chunk in kept:
        entries.append((t, sub, cur))
        cur += len(chunk)
    for t, sub, pos in entries:
        out += struct.pack('<III', t, sub, pos)
    while len(out) < hdr:
        out += b'\0'
    while len(out) % 8:
        out += b'\0'
    for i, (t, sub, chunk) in enumerate(kept):
        while len(out) < entries[i][2]:
            out += b'\0'
        out += chunk
    return bytes(out)

for path in sys.argv[1:]:
    raw = open(path, 'rb').read()
    if raw[:4] == b'Xcur':
        open(path, 'wb').write(trim(raw))
PY
}

package() {
  install -d "$pkgdir/usr/share/icons"
  tar -xJf "$srcdir/$pkgname-$pkgver.tar.xz" -C "$pkgdir/usr/share/icons"
  trim_xcursor "$pkgdir"/usr/share/icons/*/cursors/*
}