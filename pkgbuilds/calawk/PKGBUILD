# Maintainer: arozoid 
pkgname=calawk
pkgver=0.1.0
pkgrel=1
pkgdesc="Small interactive (and non-interactive) expression calculator wrapper around awk"
arch=(any)
url="https://github.com/arozoid/rstlpk"
license=(MIT)
depends=(awk sh)
makedepends=()
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 main.sh "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
