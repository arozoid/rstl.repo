# Maintainer: arozoid
pkgname=calawk
pkgver=0.1.0
pkgrel=1
pkgdesc="Small interactive (and non-interactive) expression calculator wrapper around awk"
arch=(any)
url="https://github.com/arozoid/calawk"
license=(MIT)
depends=(awk sh)
# auto: date
_commit=""
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('SKIP')

build() { :; }

package() {
  cd "$srcdir/$pkgname-$_commit"
  install -Dm755 main.sh "$pkgdir/usr/bin/$pkgname"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE" 2>/dev/null || true
}
