#!/bin/sh
# mkFRkernel — build a FRUGAL-compatible initrd from a kernel module tree.
#
# This is a standalone rework of FRmake_initrd.sh, adapted so that it can
# operate on an unpacked kernel package without installing anything into the
# host's /lib/modules and without creating device nodes as an unprivileged
# user.
#
# Copyright (c) 2026 arozoid (modifications)
# Revised: 23 Oct 2026; License: GPLv3
#
# Copyright (c) 2022 wiak (for FRmake_initrd.sh)
# Revised: 22 Oct 2023; Original license: MIT
